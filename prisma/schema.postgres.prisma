generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("WORKER")
  phone     String?
  storeSlug String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedProducts WorkerProduct[]
  ownedProducts   Product[]
}

model WorkerProduct {
  id        String   @id @default(cuid())
  workerId  String
  productId String
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([workerId, productId])
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  shortDescription String?
  fullDescription  String?
  price            Float
   images           String          @db.Text @default("[]")
   thumbnail        String          @db.Text @default("")
  stock            Int             @default(0)
  initialStock     Int             @default(0)
  orderCount       Int             @default(0)
  isActive         Boolean         @default(true)
  ownerId          String?
  owner            User?           @relation(fields: [ownerId], references: [id])
  orders           Order[]
  orderItems       OrderItem[]
  variants         ProductVariant[]
  purchaseEntries  PurchaseEntry[]
  expenses         Expense[]
  assignedWorkers  WorkerProduct[]
  hasOffers        Boolean         @default(false)
  offers           ProductOffer[]
  hasColors        Boolean         @default(false)
  colors           ProductColor[]
  hasSizes         Boolean         @default(false)
  sizes            ProductSize[]
  pageViews        ProductPageView[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ProductOffer {
  id        String   @id @default(cuid())
  productId String
  name      String
  quantity  Int
  price     Float
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  name      String
  image     String   @default("")
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  purchaseEntries PurchaseEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  name      String
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  purchaseEntries PurchaseEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  price     Float
  stock     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Wilaya {
  id    String    @id @default(cuid())
  name  String
  code  String    @unique
  orders Order[]
  baladyas Baladya[]
}

model Baladya {
  id        String   @id @default(cuid())
  name      String
  arabicName String?
  wilayaId  String
  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id], onDelete: Cascade)
  code      String?
  orders    Order[]
}

model Order {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  productId       String
  variantId       String?
  offerId         String?
  customerName    String
  customerPhone   String
  customerAddress String?
  wilayaId        String
  baladyaId       String?
  quantity        Int                 @default(1)
  productPrice    Float
  shippingPrice   Float               @default(0)
  totalPrice      Float
  purchasePrice   Float               @default(0)
  consumedEntries String?
  status              String              @default("NEW")
  attemptCount        Int                 @default(0)
  notes               String?
  deliveryReference   String?
  shippingCompany     String?
  recoveryStatus      String?
  lastRemarkType      String?
  recoveryNote        String?
  recoveredAt         DateTime?
  recoveryMessageSent Boolean  @default(false)
  pushNotifiedAt      DateTime?
  product             Product             @relation(fields: [productId], references: [id])
  variant         ProductVariant?     @relation(fields: [variantId], references: [id])
  offer           ProductOffer?       @relation(fields: [offerId], references: [id])
  wilaya          Wilaya              @relation(fields: [wilayaId], references: [id])
  baladya         Baladya?            @relation(fields: [baladyaId], references: [id])
  statusHistory   OrderStatusHistory[]
  orderItems      OrderItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([productId])
  @@index([wilayaId])
  @@index([baladyaId])
  @@index([customerPhone])
  @@index([orderNumber])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  oldStatus String?
  newStatus String
  changedBy String?
  note      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int      @default(1)
  productPrice Float
  purchasePrice Float  @default(0)
  offerId     String?
  colorId     String?
  sizeId      String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  color       ProductColor? @relation(fields: [colorId], references: [id])
  size        ProductSize?  @relation(fields: [sizeId], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model AbandonedOrder {
  id              String   @id @default(cuid())
  productId       String
  productName     String
  productImages   String?
  customerName    String?
  customerPhone   String
  wilayaCode      String?
  wilayaName      String?
  baladyaName     String?
  deliveryMethod  String?
  quantity        Int      @default(1)
  productPrice    Float?
  shippingPrice   Float?
  totalPrice      Float?
  purchasePrice   Float?
  consumedEntries String?
  offerId         String?
  offerName       String?
  status          String   @default("NEW")
  deliveryReference String?
  shippingCompany String?
  reason          String   @default("timeout")
  statusHistory   String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerPhone])
  @@index([createdAt])
}

model ProductPageView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text")
}

model PurchaseEntry {
  id          String   @id @default(cuid())
  reference   String
  date        DateTime @default(now())
  supplier    String?
  total       Float
  note        String?
  productId   String?
  quantity    Int?
  unitPrice   Float?
  remainingQty Int?
  colorId     String?
  sizeId      String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  color       ProductColor? @relation(fields: [colorId], references: [id])
  size        ProductSize?  @relation(fields: [sizeId], references: [id])
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([date])
}

model FacebookEvent {
  id          String   @id @default(cuid())
  eventName   String
  eventId     String?
  eventData   String
  source      String   @default("pixel")
  status      String   @default("pending")
  error       String?
  response    String?
  createdAt   DateTime @default(now())

  @@index([eventName])
  @@index([status])
  @@index([createdAt])
  @@index([source])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String?
  productId   String?
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([date])
  @@index([category])
}

model PaymentBatch {
  id            String   @id @default(cuid())
  batchNumber   Int
  totalAmount   Float
  orderCount    Int
  productSummary String
  productDetails String?
  paidAt        DateTime @default(now())
  note          String?

  createdAt     DateTime @default(now())

  @@index([paidAt])
  @@index([batchNumber])
}

model WeeklyAccount {
  id        String   @id @default(cuid())
  title     String
  weekStart String
  weekEnd   String

  totalOrders      Int @default(0)
  confirmedOrders  Int @default(0)
  abandonedOrders  Int @default(0)

  adSpendEuro      Float @default(0)
  exchangeRate     Float @default(0)

  deliveredOrders  Int @default(0)
  deliveredAbandoned Int @default(0)
  deliveryRate     Float @default(0)
  abandonedDeliveryRate Float @default(0)

  confirmationExpenses Float @default(0)
  packagingPerUnit     Float @default(0)

  productPurchasePrice Float @default(0)
  sellingPrice         Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([userId])
}
